// File name: projects/2/FullAdder.hdl
/**
 * Computes the sum of three bits.
 */
CHIP FullAdder {
    IN a, b, c;  
    OUT sum,     
        carry;   

    PARTS:
    And(a=a,b=b,out=carry1);
    Xor(a=a,b=b,out=sum1);
    And(a=sum1,b=c,out=carry2);
    Xor(a=sum1,b=c,out=sum);
    Or(a=carry1,b=carry2,out=carry);
    
}